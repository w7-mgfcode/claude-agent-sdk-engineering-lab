# Leave LAB_CLAUDE_MODEL empty to use the SDK / Claude Code default model.
LAB_CLAUDE_MODEL=

# Per turn/request timeout in seconds.
LAB_TURN_TIMEOUT_SECONDS=90

# Bounded agent execution for the demonstration examples.
LAB_MAX_TURNS=4
LAB_MAX_BUDGET_USD=0.25

LAB_LOG_LEVEL=INFO

# Live tests are opt-in and make a real Claude call.
RUN_LIVE_CLAUDE_TESTS=0
